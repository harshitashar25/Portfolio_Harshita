# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment
# Options: development, production, test
NODE_ENV=development

# Email Configuration
# Your email address where you want to receive contact form submissions
RECEIVER_EMAIL=your-email@example.com

# SMTP Configuration for sending emails
# You can use Gmail, Outlook, or any SMTP service

# SMTP Host (examples below)
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# Yahoo: smtp.mail.yahoo.com
# Custom SMTP: your-smtp-server.com
SMTP_HOST=smtp.gmail.com

# SMTP Port
# 587 for TLS (recommended)
# 465 for SSL
# 25 for unencrypted (not recommended)
SMTP_PORT=587

# SMTP Security
# true for SSL (port 465)
# false for TLS (port 587)
SMTP_SECURE=false

# SMTP User (your email address)
SMTP_USER=your-email@gmail.com

# SMTP Password
# For Gmail: Use an App Password (not your regular password)
# Steps for Gmail App Password:
# 1. Go to Google Account settings
# 2. Security > 2-Step Verification (must be enabled)
# 3. App passwords > Generate app password
# 4. Use the generated password here
# 
# For other providers: Use your email password or app-specific password
SMTP_PASS=your-app-password-or-email-password

